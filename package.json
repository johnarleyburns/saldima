{
  "name": "saldima",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Saldima: hosted, GnuCash-compatible accounting. Compatible with GnuCash.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && node scripts/check-gates.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:licenses": "node scripts/license-scan.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "vectors": "tsx scripts/vectors.ts",
    "check:workflows": "./scripts/check-workflows.sh",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "vectors:check": "tsx scripts/vectors.ts --check",
    "dev": "wrangler dev --ip ::",
    "reset": "node scripts/reset.mjs",
    "e2e": "playwright test",
    "e2e:ci": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.8",
    "fast-check": "^4.3.0",
    "hono": "^4.13.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "wrangler": "4.166.0"
  }
}
