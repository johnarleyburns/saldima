{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "vitest.config.ts",
    "vitest.runtime.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "coverage", "**/dist"]
}
