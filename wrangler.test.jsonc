// SPDX-License-Identifier: AGPL-3.0-only
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saldima-runtime-test",
  "main": "packages/testkit/src/runtime/worker.ts",
  "compatibility_date": "2026-11-20",
  "observability": { "enabled": false },
  "vars": {
    "ENVIRONMENT": "local",
    "SETUP_TOKEN": "local-setup-token",
    "PROVISION_SECRET": "test-provision-secret",
    "MASTER_KEY": "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
  },
  "kv_namespaces": [{ "binding": "KV", "id": "saldima-test-kv" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "saldima-test-r2" }],
  "durable_objects": { "bindings": [{ "name": "BOOK", "class_name": "Book" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Book"] }]
}
